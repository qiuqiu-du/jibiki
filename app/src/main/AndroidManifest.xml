<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Web tabs (コトバンク, Weblio) and the handwriting model download. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".JishoApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jisho">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <!-- uiMode, locale: switching light/dark or the language recomposes in place instead of
                 recreating the page, which showed a black frame (about 170 ms) in between. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
